* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve Unreal assets as binary. Enable LFS before adding large assets.
*.uasset -text
*.umap -text

# Character source and imported Unreal assets
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
Unreal/Content/** filter=lfs diff=lfs merge=lfs -text
art/**/*.glb filter=lfs diff=lfs merge=lfs -text
art/**/*.zip filter=lfs diff=lfs merge=lfs -text
art/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
