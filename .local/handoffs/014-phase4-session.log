bool Covered(const Map& map,const Soldier& k,const TacticalRoute& route){
    if(route.points.empty())return false;
    float total=0,exposed=0,stretch=0,longest=0;Vec3 before=route.start;
    for(Vec3 end:route.points){float length=Distance(before,end);int count=std::max(1,int(std::ceil(length)));
        for(int n=1;n<=count;++n){Vec3 at=before+(end-before)*(float(n)/count);bool seen=false;
            for(const auto& ct:k.contacts)if(ct.known)seen|=!ProtectedAt(map,at,ct.position,Stance::Crouched)&&ClearLine3D(map,at+Vec3{0,0,1.3f},ct.position+Vec3{0,0,1.7f});
            float d=length/count;total+=d;if(seen){exposed+=d;stretch+=d;longest=std::max(longest,stretch);}else stretch=0;
        }before=end;
    }return total>0&&exposed<=total*.4f&&longest<=10;
}
