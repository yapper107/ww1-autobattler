   169	            if(e.kind=="method_stage"&&e.reason=="sustained useful support releases staged movement"){
   170	                released=true;assert(e.support==7&&e.supportUseful);
   171	                bool evidence=false;for(const auto& report:e.deliveries)if(report.shooter==7&&report.supportWeapon&&e.time-report.observedAt<=6){
   172	                    for(const auto& shot:record.shots)physical|=shot.owner==7&&shot.time<=report.observedAt&&report.observedAt-shot.time<1;
   173	                    evidence=true;
   174	                }assert(evidence);
   175	            }
   176	            lost|=e.kind=="method_stage"&&e.reason=="support lost; retain route and prepare again";
   177	        }
   178	        std::cerr<<"support "<<variant<<" release="<<released<<" loss="<<lost<<" physical="<<physical<<"\n";
   179	        if(variant==15)assert(released&&physical&&lost);else assert(!released&&!physical);
   180	    }
   181	    std::cout<<"SCENARIO physical support: actual delivery releases movement, loss pauses it, unavailable gun cannot be replaced by rifle fire PASS\n";
   182	}
   183	static void PhysicalDeploymentScenario(){
   184	    auto config=CognitiveConfig();config.seed=107;config.maxSeconds=70;
   185	    auto record=Simulate(config,{}, {},17);
   186	    bool waiting=false,released=false,travel=false,transported=false;
   187	    std::vector<std::pair<uint64_t,float>> waits;
   188	    const auto start=record.frames.front().soldiers[15].position;
   189	    for(const auto& frame:record.frames){
   190	        const auto& leader=frame.soldiers[0];const auto& progress=leader.supportProgress;
   191	        if(progress.shooter==15){
   192	            assert(progress.observedAt+config.reportDelay<=frame.time+.001f);
   193	            assert(progress.statusAt<=progress.observedAt&&progress.assignment!=0);
   194	            transported=true;
   195	        }
   196	        travel|=Distance(frame.soldiers[15].position,start)>25;
   197	    }
   198	    for(const auto& entry:record.diagnostics->entries)if(entry.squad==0){
   199	        if(entry.kind=="method_support_deploying"&&entry.support==15){
   200	            waiting=true;waits.push_back({entry.intent.id,entry.time});
   201	            assert(!entry.supportUseful&&entry.support==15&&entry.supportProgress.shooter==15);
   202	            assert(entry.supportDeadline>31&&entry.supportProgress.status!=TaskStatus::Done);
   203	        }
   204	        if(entry.kind=="method_stage"&&entry.reason=="sustained useful support releases staged movement"){
   205	            assert(entry.support==15);
   206	            float waitAt=-1;for(const auto& wait:waits)if(wait.first==entry.intent.id&&wait.second<entry.time)waitAt=std::max(waitAt,wait.second);
   207	            assert(waiting&&waitAt>=0&&entry.time>31&&entry.time>waitAt);
   208	            bool physical=false;
   209	            for(const auto& delivery:entry.deliveries)if(delivery.shooter==15&&delivery.supportWeapon&&entry.time-delivery.observedAt<=6){
   210	                assert(delivery.observedAt+config.reportDelay<=entry.time+.001f);
   211	                for(const auto& shot:record.shots)physical|=shot.owner==15&&shot.time<=delivery.observedAt&&delivery.observedAt-shot.time<1;
   212	            }
   213	            assert(physical);released=true;
   214	        }
   215	    }
   216	    assert(waiting&&released&&travel&&transported);
   217	    std::cout<<"SCENARIO physical cross-squad deployment: long obstructed relocation retains method past initial wait, delayed original evidence releases movement PASS\n";
   218	}
   219	static void ProtectedTransitScenario(){
   220	    auto config=CognitiveConfig();auto frame=InitialFrame(config);PlaceCognitiveSquadTogether(frame);Map map;PrepareGeometry(map);
   221	    auto& leader=frame.soldiers[0];leader.position={0,0};CognitiveOrder(leader,{72,0},{80,0});
   222	    SquadCommand command;UpdateCognitivePlan(leader,CognitiveSquad(frame),map,config,command,nullptr,1);
   223	    const auto& route=command.accepted.route;assert(route&&route->stages.size()>1);
   224	    bool continuous=false;size_t end=0;float seconds=0;
   225	    for(const auto& stage:route->stages){assert(stage.begin==end&&stage.end>stage.begin);end=stage.end;seconds+=stage.seconds;
   226	        continuous|=stage.seconds*route->speed>18;assert(stage.seconds<=10);}
   227	    assert(continuous&&end==route->points.size()&&std::abs(seconds-route->cost.travel)<.01f);
   228	    assert(Distance(route->stages.back().destination,route->destination)<.01f);
   229	    auto orders=CognitiveOrders(leader,CognitiveSquad(frame),command);
   230	    for(const auto& order:orders)if(command.accepted.movers[order.recipient%SquadSize])assert(order.execution.completion==Completion::Transit);
   231	    std::cout<<"SCENARIO protected transit: continuous planned corridor, bounded stages, separate final occupation PASS\n";
   232	}
   233	static void NormalMapScenarios(){
   234	    for(auto terrain:{Terrain::FracturedWorks,Terrain::Trenches}){
   235	        auto c=CognitiveConfig();c.terrain=terrain;c.seed=108;c.maxSeconds=600;c.supportWeapon=false;
   236	        auto record=Simulate(c);bool failure=false,occlusion=false;int successions=0;
   237	        for(const auto& event:record.events)successions+=event.kind==EventKind::Succession&&event.text.find("down:")!=std::string::npos;
   238	        for(const auto& frame:record.frames){
   239	            for(const auto& observer:frame.soldiers)if(observer.Active())for(const auto& enemy:frame.soldiers)
   240	                if(enemy.Active()&&enemy.team!=observer.team&&Distance(observer.position,enemy.position)<SightRange(observer)&&!ClearLine3D(record.map,observer.position+Vec3{0,0,1.7f},enemy.position+Vec3{0,0,1.2f}))occlusion=true;
   241	        }
   242	        for(const auto& entry:record.diagnostics->entries)if(entry.soldier<32){
   243	            assert(entry.kind!="method_stage"||entry.reason!="sustained useful support releases staged movement");
   244	            failure|=entry.kind=="method_exhausted";
   245	        }
   246	        assert(failure&&occlusion&&successions>0);
   247	        std::cout<<"SCENARIO normal map "<<int(terrain)<<": obstructed views, command succession, unavailable support reported; duration="<<record.duration<<" PASS\n";
   248	    }
   249	}
   250	static void SplitSquadAllocationControl(){
   251	    auto config=CognitiveConfig();auto frame=InitialFrame(config);Map map;PrepareGeometry(map);
   252	    auto& leader=frame.soldiers[0];leader.position={0,0};leader.contacts[32]={true,false,{40,0},0};
   253	    CognitiveOrder(leader,{24,0},{40,0});SquadCommand command;
   254	    UpdateCognitivePlan(leader,CognitiveSquad(frame),map,config,command,nullptr,1);
   255	    const auto& plan=command.accepted;int available=0;bool unreachable=false;
   256	    for(int n=0;n<SquadSize;++n)available+=plan.movers[n]&&!plan.unavailable[n];
   257	    for(const auto& failure:plan.attempts)unreachable|=failure.cause==TaskCause::Unreachable;
   258	    assert(plan.stage==MethodStage::Blocked&&available<plan.requiredOccupants&&unreachable);
   259	    for(const auto& order:CognitiveOrders(leader,CognitiveSquad(frame),command))
   260	        if(plan.movers[order.recipient%SquadSize])assert(order.execution.completion==Completion::Occupy&&!order.teamPlan.released);
   261	    std::cout<<"SCENARIO split squad: missing connected objective slots block; no fabricated transit PASS\n";
   262	}
