void Pause(const Soldier& l,const std::vector<Soldier>& members,DrillPlan& p,Diagnostics* d,float time,bool pause){
    if(p.action.paused==pause)return;
    p.action.paused=pause;
    for(const auto& s:members){int n=s.id%8;if(p.elements[n]==1&&p.action.rushOrders[n]){p.action.pausedOrders[n]=pause;p.issue[n]=true;}}
