   179	}
   180	}
   181	bool BeginContactAction(const Soldier& l,const Soldier& knowledge,const std::vector<Soldier>& members,const Map& map,const Config& config,DrillPlan& p,Diagnostics* d,float time){
   182	    bool incoming=p.effectiveFire||l.understoodSuppression>.3f;
   183	    for(const auto& s:members)incoming|=s.suppression>.3f;
   184	    for(const auto& fire:l.fireAreas)incoming|=time-fire.observedAt<6&&fire.intensity>.3f;
   185	    bool protectedSlot=false;for(const auto& s:members){int n=s.id%8;protectedSlot|=p.hasSlot[n]&&ProtectedAt(map,p.slots[n].shelter,p.sector,Stance::Crouched);}
   186	    if(incoming&&!protectedSlot){
   187	        p.effectiveFire=true; // Immediate emergency overrides ordinary assessment hysteresis.
   188	        ActionTrace(l,p,d,time,"drill_stage","BreakContact: effective incoming fire with zero protected slots");
   189	        BeginRetire(l,members,map,p,d,time,false);
   190	        ActionTrace(l,p,d,time,"drill_stage","rearward bound: emergency takes precedence over attack or fallback");
   191	        return true;
   192	    }
   193	    if(p.target<0||p.strength[0]<2)return false;
   194	    if(p.retreat&&p.effectiveFire){BeginRetire(l,members,map,p,d,time,false);return true;}
   195	    // A contact requiring deliberate fire and manoeuvre, not quiet route travel.
   196	    if(p.superiority||Distance(p.center,p.sector)>100)return false;
   197	    Accept(l,p,BattleDrill::SupportByFire,d,time,"SupportByFire: contact assessment deploys gun group");
   198	    p.action.initialStrength=int(members.size());p.action.base=Centre(members,p,0);
   199	    for(int id=0;id<UnitCount;++id)p.action.threats[id]=knowledge.contacts[id].known;
   200	    p.action.route=Flank(l,knowledge,members,map,config,p,d,time,false);p.action.attack=bool(p.action.route);
   201	    if(p.action.attack){p.kind=BattleDrill::SquadAttack;ActionTrace(l,p,d,time,"drill_candidate","SquadAttack: covered flank sector 40-60 degrees, 20-45 m");}
   202	    if(!p.action.attack){
   203	        Assign(l,members,Element(members,p,0),map,p,p.center,true,Task::BoundCover,Completion::Support,true,false,d,time);
   204	        p.action.active=false;p.action.closureFallback=true;p.action.cause=TaskCause::Support;p.closeAfterCover=true;
   205	        p.movingElement=1;
   206	        ActionTrace(l,p,d,time,"drill_stage_advanced","no covered route: report upward and continue supported bounding closure");
   207	        return false; // Existing committed movement stages own the bounds.
   208	    }
   209	    Stage(l,p,d,time,DrillStage::SupportPrepare,"prepare element support; assault permission withheld pending delivered rounds");
   210	    int slots=Assign(l,members,Element(members,p,0),map,p,p.center,true,Task::BoundCover,Completion::Support,true,false,d,time);
