                Pause(l,members,p,d,time,false);
            }
            Stage(l,p,d,time,DrillStage::Assault,"lift allowance elapsed: supported short assault bound");
            Assign(l,members,buddy,map,p,goal,false,Task::BoundMove,Completion::Transit,false,true,d,time);p.action.completed=true;return true;
        }
        if(arrived){
            bool live=false;for(const auto& ct:knowledge.contacts)live|=ct.known&&Distance(ct.position,p.action.objective)<12;
            int occupied=0,required=0;for(const auto& s:members)if(p.elements[s.id%8]==1){++required;const auto& r=l.taskReports[s.id%8];occupied+=r.id==p.expected[s.id%8]&&r.execution.method==p.instance&&r.status==TaskStatus::Done&&Distance(r.position,p.action.objective)<=12;}
            if(occupied*2>=required&&!live){
                float nearest=1e9f;for(const auto& ct:knowledge.contacts)if(ct.known&&Distance(p.center,ct.position)<nearest){nearest=Distance(p.center,ct.position);p.sector=ct.position;}
                Stage(l,p,d,time,DrillStage::Consolidate,"objective receipts and no known enemy: consolidate on remaining threats");Assign(l,members,members,map,p,p.action.objective,true,Task::Overwatch,Completion::Occupy,false,false,d,time);}
            else {p.action.buddy=1-p.action.buddy;p.action.completed=false;}
        }return true;
    }
    if(p.stage==DrillStage::Consolidate&&arrived){p.action.active=false;Stage(l,p,d,time,DrillStage::Reorganise,"consolidation receipts: Reorganise once at completion");}
    return true;
}
