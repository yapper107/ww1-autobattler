   171	void BeginRetire(const Soldier& l,const std::vector<Soldier>& members,const Map& map,DrillPlan& p,Diagnostics* d,float time,bool withdraw){
   172	    Vec3 rally=withdraw?l.platoonOrder.intent.objective:p.center-Direction(p.sector-p.center)*80;
   173	    Accept(l,p,withdraw?BattleDrill::Withdraw:BattleDrill::BreakContact,d,time,withdraw?"Withdraw to received rally":"BreakContact: believed ratio at least two without superiority");
   174	    p.action.rally=rally;p.action.objective=p.sector;p.retreat=true;p.movingElement=1;
   175	    Stage(l,p,d,time,DrillStage::Retire,"rearward bound: one stationary suppressing element");
   176	    Assign(l,members,Element(members,p,0),map,p,p.center,true,Task::BoundCover,Completion::Support,true,false,d,time);
   177	    Vec3 start=Centre(members,p,1),goal=start+Direction(rally-start)*std::min(30.f,Distance(rally,start));
