from pathlib import Path
from concurrent.futures import ThreadPoolExecutor,as_completed
import json,subprocess
root=Path('.local/phase1');binary=str((root/'battle-lab').resolve())
family=json.loads((root/'f1-dev/family.json').read_text())['cases']
authored=json.loads((root/'authored-parity/parity.json').read_text())
cases=[]
for terrain,name in enumerate(('works','trenches')):
 r=next(r for r in authored if r['controller']=='candidate90' and r['map']==name and r['seed']==107)
 cases.append((name,['--cognition','--terrain',str(terrain)],r['actual'],r['manifest']))
for controller in ('legacy','candidate90'):
 r=next(r for r in family if r['controller']==controller and r['gen_seed']==1 and r['seed']==107)
 cases.append(('F1-'+controller,['--legacy-ai' if controller=='legacy' else '--cognition','--generated','F1','--gen-seed','1'],r['digest'],str(Path(r['run'])/'manifest.json')))
def run(case):
 name,flags,digest,reference=case;dest=root/'trace-parity'/name
 cmd=[binary,*flags,'--seed','107','--seconds','360','--out',str(dest)]
 p=subprocess.run(cmd,text=True,capture_output=True);assert p.returncode==0,p.stderr
 folder=dest/json.loads((dest/'latest.json').read_text())['run'];m=json.loads((folder/'manifest.json').read_text())
 return dict(case=name,expected=digest,actual=m['gameplay_digest'],match=digest==m['gameplay_digest'],reference=reference,manifest=str(folder/'manifest.json'),command=cmd)
results=[]
with ThreadPoolExecutor(max_workers=2) as pool:
 for future in as_completed([pool.submit(run,c) for c in cases]):
  r=future.result();results.append(r);(root/'trace-parity.json').write_text(json.dumps(results,indent=2)+'\n');print(r['case'],r['match'],flush=True)
assert all(r['match'] for r in results)
