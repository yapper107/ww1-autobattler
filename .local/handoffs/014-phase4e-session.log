static Vec3 PlatoonCentre(const Frame& f,int squad){Vec3 sum{};int n=0;for(const auto& s:f.soldiers)if(s.squad==squad&&s.Active()&&!IsPlatoonStaff(s)){sum=sum+s.position;++n;}return n?sum*(1.f/n):Vec3{};}
static bool PlatoonTrace(const Record& r,const char* kind){return std::any_of(r.diagnostics->entries.begin(),r.diagnostics->entries.end(),[&](const TraceEntry& e){return e.kind==kind;});}
static void PlatoonP01(){
    auto c=DrillConfig();c.maxSeconds=300;auto live=Simulate(c,{}, {},70);c.maxSeconds=100;auto bare=Simulate(c,{}, {},71);
    bool fixing=false,two=false,reserve=false,angle=false,controlFlank=false,controlUnsafe=false;
    for(const auto& f:live.frames){const auto& t=f.platoon[0].tasks;int flank=0;
        for(int n=0;n<4;++n){const auto& a=t.assigned[n];if(!a.taskNode)continue;
            fixing|=a.task==PlatoonTask::Support&&a.supportSoldier>=0&&a.supportSoldier/8==n;
            if(a.task==PlatoonTask::FlankNorth||a.task==PlatoonTask::FlankSouth){++flank;Vec3 position=PlatoonCentre(f,n),fix=a.supportSquad<0?Vec3{}:PlatoonCentre(f,a.supportSquad);Vec3 x=fix-a.sector,y=position-a.sector;
                if(Length(x)>0&&Length(y)>0&&Distance(position,a.position)<12){float degrees=std::acos(std::clamp((x.x*y.x+x.y*y.y)/(Length(x)*Length(y)),-1.f,1.f))*180/3.14159265f;angle|=degrees>=45;}}
            if(a.task==PlatoonTask::Reserve&&a.supportSquad>=0){auto fix=PlatoonCentre(f,a.supportSquad);reserve|=a.hasArea&&a.position.x>=a.areaMin.x&&a.position.x<=a.areaMax.x&&a.position.y>=a.areaMin.y&&a.position.y<=a.areaMax.y&&(a.position.x-fix.x)*(a.sector.x-fix.x)+(a.position.y-fix.y)*(a.sector.y-fix.y)<0;}
        }two|=flank>=2;
    }
    for(const auto& f:bare.frames)for(int n=0;n<4;++n){const auto& a=f.platoon[0].tasks.assigned[n];controlFlank|=a.task==PlatoonTask::FlankNorth||a.task==PlatoonTask::FlankSouth;
        if(a.taskNode&&a.enemy>=0)for(const auto& s:f.soldiers)if(s.squad==n&&s.Active()&&Distance(s.position,a.sector)<18)controlUnsafe|=!ProtectedAt(bare.map,s.position,a.sector,Stance::Crouched);}
    std::cout<<"P01 fix_weapon="<<fixing<<" two_flanks="<<two<<" reserve="<<reserve<<" arrival_angle="<<angle<<" claims="<<PlatoonTrace(live,"platoon_corridor")<<" bare_flank="<<controlFlank<<" bare_unsafe="<<controlUnsafe<<" honest="<<PlatoonTrace(bare,"platoon_blocked")<<"\n";
    assert(fixing&&two&&reserve&&angle&&PlatoonTrace(live,"platoon_corridor")&&!controlFlank&&!controlUnsafe&&PlatoonTrace(bare,"platoon_blocked"));
}
static void PlatoonP02(){
    auto c=DrillConfig();c.maxSeconds=150;auto claimed=Simulate(c,{}, {},72);
#ifdef ARMY_TEST_CONTROLS
    c.testNoCorridorClaims=true;
#endif
    auto free=Simulate(c,{}, {},73);float minimum=1e9f;bool sampled=false,overlap=false,controlOverlap=false;
    auto inspect=[&](const Record& r,bool control){for(const auto& f:r.frames){const auto& claims=f.platoon[0].tasks.claims;
        for(size_t i=0;i<claims.size();++i)for(size_t j=i+1;j<claims.size();++j){const auto& a=claims[i];const auto& b=claims[j];if(!a.route||!b.route)continue;
            if(!control){sampled=true;minimum=std::min(minimum,Distance(PlatoonCentre(f,a.squad),PlatoonCentre(f,b.squad)));}
            for(Vec3 p:a.route->points){bool hit=CorridorDistance(*b.route,p)<b.width;if(control)controlOverlap|=hit;else overlap|=hit;}
        }
    }};inspect(claimed,false);inspect(free,true);
    std::cout<<"P02 sampled="<<sampled<<" min_centroid="<<minimum<<" overlap="<<overlap<<" disabled_claim_overlap="<<controlOverlap<<"\n";assert(sampled&&minimum>=20&&!overlap&&controlOverlap);
}
static void PlatoonP03(){
    auto c=DrillConfig();c.maxSeconds=300;auto live=Simulate(c,{}, {},74);c.maxSeconds=100;auto bare=Simulate(c,{}, {},75);float issued=-1,amendment=-1,received=-1;int fixing=-1,late=0;Vec3 sector{};bool control=false;
    for(const auto& e:live.diagnostics->entries)if(e.kind=="platoon_lift"&&issued<0){issued=e.time;fixing=e.squad;sector=e.goal;}
    for(const auto& f:live.frames)if(fixing>=0){for(const auto& s:f.soldiers)if(s.squad==fixing&&s.platoonOrder.liftFire&&amendment<0)amendment=f.time;bool all=true;for(const auto& s:f.soldiers)if(s.squad==fixing&&s.Active()&&!IsPlatoonStaff(s))all&=s.assignment.teamPlan.liftFire;if(all&&received<0)received=f.time;}
    for(const auto& shot:live.shots)if(received>=0&&shot.time>received&&shot.owner/8==fixing&&Distance(shot.aimedAt,sector)<12)++late;
    control=PlatoonTrace(bare,"platoon_lift");std::cout<<"P03 phase_received="<<issued<<" fixing_received="<<amendment<<" lifted="<<received<<" late="<<late<<" no_phase_lift="<<control<<"\n";
    assert(issued>=0&&received>=issued&&amendment>=issued&&received-amendment<=c.reportDelay+1&&late==0&&!control);
}
static void PlatoonP04(){
    auto c=DrillConfig();c.maxSeconds=45;auto loss=Simulate(c,{}, {},76),control=Simulate(c,{}, {},77);float successor=-1,issued=-1;bool autonomous=false,controlChanged=false;
    for(const auto& f:loss.frames){if(f.time>=20&&f.time<23)for(int n=1;n<4;++n)autonomous|=f.command[n].battleDrill.initialized&&f.command[n].battleDrill.instance>0;
        if(f.time>=20&&f.platoon[0].leader==6&&successor<0)successor=f.time;}
    for(const auto& e:loss.events)if(e.actor==6&&e.kind==EventKind::OrderIssued&&e.time>=20&&e.text.find("Platoon task-tree directive:")==0&&issued<0)issued=e.time;
    for(const auto& f:control.frames)controlChanged|=f.platoon[0].leader!=5;
    std::cout<<"P04 autonomous="<<autonomous<<" successor="<<successor<<" directive="<<issued<<" control_changed="<<controlChanged<<"\n";assert(autonomous&&successor>=20&&issued>=successor&&issued<=28&&!controlChanged);
}
static void PlatoonP05(){
    auto c=DrillConfig();c.maxSeconds=100;auto weak=Simulate(c,{}, {},78),strong=Simulate(c,{}, {},79);bool withdrew=false,alternate=false,inside=true,control=false;int previous=-1;
    float strongestBelief=0;for(const auto& e:weak.diagnostics->entries)if(e.kind=="mental_map"&&e.soldier==5&&e.time<=20){float believed=0;for(const auto& cell:e.regions)believed+=cell.estimate+cell.automaticWeapons*1.5f;strongestBelief=std::max(strongestBelief,believed);}
    int strength=0;for(const auto& soldier:weak.frames.front().soldiers)if(soldier.team==0&&soldier.Active()&&!IsPlatoonStaff(soldier))++strength;
    std::cout<<"P05 belief_by20="<<strongestBelief<<" reported_strength_bound="<<strength<<" ratio="<<(strongestBelief?strength/strongestBelief:100)<<"\n";
    assert(strongestBelief>2*strength);
    for(const auto& f:weak.frames){for(const auto& a:f.platoon[0].tasks.assigned)if(a.task==PlatoonTask::Withdraw){withdrew=true;inside&=a.position.x>=a.areaMin.x&&a.position.x<=a.areaMax.x&&a.position.y>=a.areaMin.y&&a.position.y<=a.areaMax.y;}
        const auto& p=f.command[0].battleDrill;if(p.kind==BattleDrill::Withdraw){if(previous>=0&&previous!=p.movingElement)alternate=true;previous=p.movingElement;}}
    for(const auto& f:strong.frames)for(const auto& a:f.platoon[0].tasks.assigned)control|=a.task==PlatoonTask::Withdraw;
    std::cout<<"P05 withdraw="<<withdrew<<" alternate="<<alternate<<" rally_in_area="<<inside<<" strong_withdraw="<<control<<"\n";assert(withdrew&&alternate&&inside&&!control);
}
static void PlatoonP06(){
    auto c=DrillConfig();c.maxSeconds=165;auto live=Simulate(c,{}, {},80),disrupted=Simulate(c,{}, {},81);int renewals=0;bool bounded=true,executed=true;
    for(const auto* record:{&live,&disrupted})for(const auto& f:record->frames)for(const auto& s:f.soldiers)if(s.Active()&&s.platoonOrder.taskNode){const auto& a=s.platoonOrder;bounded&=a.expiresAt-a.issuedAt>=60&&a.expiresAt-a.issuedAt<=90;
