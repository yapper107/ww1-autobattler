    d.areaMax={std::min(map.halfWidth-2,std::max(start.x,goal.x)+half),std::min(map.halfHeight-2,std::max(start.y,goal.y)+half)};
}
bool Lines(const Map& map,Vec3 at,Vec3 target,float range){return Distance(at,target)<=range&&ClearLine3D(map,at+Vec3{0,0,1.5f},target+Vec3{0,0,1.7f});}
}
std::vector<PlannedPlatoonOrder> PlanPlatoonTasks(const Soldier& l,const Map& map,const Config& config,PlatoonTaskState& state,Diagnostics* d,float time,bool claimsEnabled){
