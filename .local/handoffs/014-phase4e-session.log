            state.fireControl.push_back({r.squad,r.phaseLineAt,r.observedAt,true,{r.assaultOrigin,r.assaultObjective,.08f,time}});
            Trace(l,d,time,"platoon_fire_control","received phase line: retain lane lift independently of fixing task",r.assaultObjective,r.squad);
        }
