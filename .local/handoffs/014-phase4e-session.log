namespace army {
namespace {
Vec3 Unit(Vec3 p){p.z=0;return Length(p)>.01f?p*(1/Length(p)):Vec3{1,0};}
void Trace(const Soldier& l,Diagnostics* d,float time,const char* kind,const std::string& why,Vec3 goal={},int squad=-1){
    if(!d||!d->options.enabled)return;
    TraceEntry e;e.id=d->nextId++;e.time=time;e.soldier=l.id;e.squad=squad<0?l.squad:squad;e.kind=kind;e.reason=why;e.goal=goal;d->entries.push_back(e);
}
// Kruskal's minimum spanning forest cut at20 m; contacts retain their original timestamps.
std::vector<std::vector<int>> Groups(const Soldier& k){
    std::vector<int> ids;for(int n=0;n<UnitCount;++n)if(k.contacts[n].known)ids.push_back(n);
    struct Edge{float distance;int a,b;};std::vector<Edge> edges;
    for(size_t a=0;a<ids.size();++a)for(size_t b=a+1;b<ids.size();++b)edges.push_back({Distance(k.contacts[ids[a]].position,k.contacts[ids[b]].position),int(a),int(b)});
    std::stable_sort(edges.begin(),edges.end(),[](const Edge&a,const Edge&b){return a.distance<b.distance;});
    std::vector<int> parent(ids.size());std::iota(parent.begin(),parent.end(),0);
    auto root=[&](int n){while(parent[n]!=n)n=parent[n];return n;};
    for(auto e:edges)if(e.distance<=20){int a=root(e.a),b=root(e.b);if(a!=b)parent[b]=a;}
    std::vector<std::vector<int>> out;std::vector<int> roots;
    for(size_t i=0;i<ids.size();++i){int r=root(int(i));auto at=std::find(roots.begin(),roots.end(),r);if(at==roots.end()){roots.push_back(r);out.push_back({});at=roots.end()-1;}out[size_t(at-roots.begin())].push_back(ids[i]);}return out;
}
bool Covered(const Map& map,const Soldier& k,const TacticalRoute& route){
    if(route.points.empty())return false;
    float total=0,exposed=0,stretch=0,longest=0;Vec3 before=route.start;
    for(Vec3 end:route.points){float length=Distance(before,end);int count=std::max(1,int(std::ceil(length)));
        for(int n=1;n<=count;++n){Vec3 at=before+(end-before)*(float(n)/count);bool seen=false;
            for(const auto& ct:k.contacts)if(ct.known)seen|=!ProtectedAt(map,at,ct.position,Stance::Crouched)&&ClearLine3D(map,at+Vec3{0,0,1.3f},ct.position+Vec3{0,0,1.7f});
            float d=length/count;total+=d;if(seen){exposed+=d;stretch+=d;longest=std::max(longest,stretch);}else stretch=0;
        }before=end;
    }return total>0&&exposed<=total*.4f&&longest<=10;
}
// Exact planar segment separation, including the route starts and crossings.
float SegmentDistance(Vec3 a,Vec3 b,Vec3 c,Vec3 d){
    auto cross=[](Vec3 x,Vec3 y){return x.x*y.y-x.y*y.x;};
    const Vec3 u=b-a,v=d-c;const float den=cross(u,v);
    if(std::abs(den)>1e-6f){float t=cross(c-a,v)/den,q=cross(c-a,u)/den;if(t>=0&&t<=1&&q>=0&&q<=1)return 0;}
    auto point=[](Vec3 p,Vec3 a,Vec3 b){Vec3 v=b-a;v.z=0;Vec3 w=p-a;w.z=0;float n=v.x*v.x+v.y*v.y;return Length(w-v*(n>0?std::clamp((w.x*v.x+w.y*v.y)/n,0.f,1.f):0.f));};
    return std::min({point(a,c,d),point(b,c,d),point(c,a,b),point(d,a,b)});
}
bool Separated(const TacticalRoute& a,const TacticalRoute& b){
    Vec3 from=a.start;for(Vec3 to:a.points){Vec3 other=b.start;for(Vec3 end:b.points){if(SegmentDistance(from,to,other,end)<20)return false;other=end;}from=to;}return true;
}
std::shared_ptr<TacticalRoute> Route(const Soldier& k,const Map& map,const Config& c,Vec3 start,Vec3 goal,float time,const std::vector<CorridorClaim>& claims,int squad,bool claimCosts){
    TacticalRoutePlanner planner(map,k,time,k.team?c.emberDoctrine:c.doctrine,Stance::Crouched);
    Vec3 resolved;if(!ResolveOrderPosition(map,start,goal,resolved))return {};
