    checks.append(dict(path=name,match=pathlib.Path(name).read_bytes()==(original/name).read_bytes()))
assert all(c['match'] for c in checks)
(base/'protected-final.json').write_text(json.dumps(checks,indent=2)+'\\n')
changed=[];patch=[]
for dirname in ('Unreal/Source','tests','scripts','tools'):
    for p in sorted(pathlib.Path(dirname).rglob('*')):
        if not p.is_file() or '__pycache__' in p.parts:continue
        old=original/p
        before=old.read_bytes() if old.exists() else b''
        after=p.read_bytes()
        if before==after:continue
        changed.append(str(p))
        patch.extend(difflib.unified_diff(before.decode().splitlines(True),after.decode().splitlines(True),fromfile='before/'+str(p),tofile='after/'+str(p)))
(base/'changed-files.json').write_text(json.dumps(changed,indent=2)+'\\n')
(base/'changes.patch').write_text(''.join(patch))
print('Protected checks passed:',len(checks),'attributable implementation files:',len(changed))
