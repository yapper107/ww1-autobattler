for increment in a.increments:
    for terrain,mapname in enumerate(('works','trenches')):
        for seed in (range(100,110) if a.all_seeds else [107]):tasks.append((increment,terrain,mapname,seed))
def check(task):
    increment,terrain,mapname,seed=task;root=base/f'increment{increment}'
    reference=json.loads(next((root/'cognition'/mapname/str(seed)).glob('*/manifest.json')).read_text())
    out=base/'trace-parity'/f'increment{increment}'/mapname/str(seed)
