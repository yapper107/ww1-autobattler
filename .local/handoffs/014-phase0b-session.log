    checks.append(dict(path=p,expected=digest,actual=actual,match=actual==digest))
p=pathlib.Path('Unreal/Source/ArmyPrototype/Sim/BattleSim.cpp')
def authored(path):
    s=path.read_text();return s[s.index('void MakeMGEncounter'):s.index('float AimSeconds')]
