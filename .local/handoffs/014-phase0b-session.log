            TraceEntry e;e.id=diagnostics->nextId++;e.time=time;e.soldier=s.id;e.squad=s.squad;
            e.kind="position_query";e.reason=std::string(covering?"covering band 12..25; ":"objective occupant; ")+"interval="+std::to_string(interval)+(p.unavailable[index]?"; unavailable":"; assigned");
            e.intent=p.intent;e.position=s.position;e.goal=p.positions[index];e.peek=p.hasSlot[index]?p.slots[index].peek:e.goal;
