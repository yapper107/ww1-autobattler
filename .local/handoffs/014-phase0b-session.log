            else soldier.position={-55.f-float(slot/4)*2.f,mirror*(-24.f-2.f*(slot%4)),0};
            soldier.goal=soldier.position;soldier.stance=Stance::Crouched;
        }
    }
    PrepareGeometry(map);
}
