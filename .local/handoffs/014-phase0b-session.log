import argparse, concurrent.futures, json, subprocess, sys, time
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('increment');p.add_argument('--jobs',type=int,default=4);a=p.parse_args()
root=Path('.local/phase0b')/a.increment
binary=root/'battle-lab'
assert binary.exists()
commands=[]
for controller in ('legacy','cognition'):
    for terrain in (0,1):
        for seed in range(100,110):
            out=root/controller/('works' if terrain==0 else 'trenches')/str(seed)
            assert not out.exists(), out
            cmd=[str(binary),'--legacy-ai' if controller=='legacy' else '--cognition','--terrain',str(terrain),'--seed',str(seed),'--seconds','360','--evaluate','--no-trace','--out',str(out)]
            commands.append(cmd)
(root/'commands.json').write_text(json.dumps(commands,indent=2)+'\n')
def run(cmd):
    start=time.monotonic();r=subprocess.run(cmd,text=True,capture_output=True)
    return dict(command=cmd,returncode=r.returncode,seconds=time.monotonic()-start,stdout=r.stdout,stderr=r.stderr)
results=[]
with concurrent.futures.ThreadPoolExecutor(max_workers=a.jobs) as pool:
    for future in concurrent.futures.as_completed([pool.submit(run,c) for c in commands]):
        result=future.result();results.append(result)
        (root/'runs.json').write_text(json.dumps(results,indent=2)+'\n')
        print(f'{len(results)}/40 rc={result["returncode"]}: {result["stdout"].strip()}',flush=True)
assert all(r['returncode']==0 for r in results)
for terrain in ('works','trenches'):
    for tool,metric in [('measure_dispersion','dispersion'),('evaluate_tactics','tactics')]:
        subprocess.run([sys.executable,f'tools/{tool}.py',str(root/'legacy'/terrain),str(root/'cognition'/terrain),'--out',str(root/f'{metric}-{terrain}.json')],check=True)
print('Complete',a.increment,flush=True)
