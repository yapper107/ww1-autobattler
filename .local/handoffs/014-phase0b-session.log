// Plan 014 hotfix mechanisms. All physical runs use Simulate's real transport,
// sensing, reaction queues and receipts; never fabricate delivery evidence.
static void CrowdingMissionScenario(){
    auto config=CognitiveConfig();config.maxSeconds=6;
    auto centre=Simulate(config,DiagnosticOptions{}, {},44);
    config.approach=Approach::North;
    auto north=Simulate(config,DiagnosticOptions{}, {},44);
    std::array<Vec3,SquadCount> centreGoals{},northGoals{};
    for(const auto* record:{&centre,&north}){
        std::array<int,SquadCount> initialised{};bool receipt=false;
        for(const auto& e:record->diagnostics->entries){
            if(e.kind==\"mission_initialised\"){
                ++initialised[e.squad];
                (record==&centre?centreGoals:northGoals)[e.squad]=e.intent.objective;
            }
            if(e.kind==\"order_received\"&&e.time>=MessageDelay)receipt=true;
        }
        for(int squad=0;squad<SquadCount;++squad){
            assert(initialised[squad]==1);
            const auto goal=(record==&centre?centreGoals:northGoals)[squad];
            assert(Distance(goal,{0,0})>15);
            for(const auto& frame:record->frames)if(frame.time>0&&frame.command[squad].accepted.directive==0)
                assert(Distance(frame.command[squad].accepted.mission.objective,goal)<.01f);
        }
        assert(receipt);
    }
    for(int squad=1;squad<4;++squad)assert(Distance(centreGoals[squad],centreGoals[squad-1])>=15);
    assert(Distance(centreGoals[0],northGoals[0])>5);
    for(int squad=4;squad<8;++squad)assert(Distance(centreGoals[squad],northGoals[squad])<.01f);
    std::cout<<\"SCENARIO 44 mission: distinct retained deployment goals, real order receipts; North-only control changes Azure goals PASS\\n\";
}
static void CrowdingTests(){CrowdingMissionScenario();}
