from concurrent.futures import ThreadPoolExecutor,as_completed
from pathlib import Path
import subprocess,json
root=Path('.local/phase3c/mechanisms');root.mkdir(exist_ok=True)
def run(name):
 cmd=['.local/phase3c/final/sim-tests','--drills',name]
 with (root/(name+'.log')).open('w') as log:code=subprocess.call(cmd,stdout=log,stderr=subprocess.STDOUT)
 return dict(name=name,command=cmd,exit_code=code,log=str(root/(name+'.log')))
results=[]
with ThreadPoolExecutor(max_workers=2) as pool:
 for f in as_completed([pool.submit(run,n) for n in ('projection','sector','positions','plumbing','lifecycle','D01','D02','D03','D04','D05','D17','D06','D07','D08','D09','D10','D11','D16')]):
  r=f.result();results.append(r);print(r,flush=True);(root/'results.json').write_text(json.dumps(results,indent=2)+'\n')

