+    if(Distance(s.position,s.assignment.position)>.7f&&
+        ((s.assignment.drillInstance>0&&s.assignment.execution.rushSeconds>0)||!(s.assignment.hasSlot&&memory.assigned&&Distance(memory.shelter,s.assignment.position)<.04f))){
