import argparse, json, subprocess, sys, time
from pathlib import Path


def main():
    p=argparse.ArgumentParser()
    p.add_argument('increment')
    p.add_argument('--root',type=Path,default=Path('.local/phase0b'))
    a=p.parse_args()
    root=a.root/a.increment
    binary=root/'battle-lab'
    if not binary.exists():p.error(f'Missing preserved binary: {binary}')
    # One launch at a time: no queued jobs may continue past the third zero.
    commands=[];results=[];sets=[]
    for controller in ('cognition','legacy'):
        for terrain,mapname in enumerate(('works','trenches')):
            zero=0
            for seed in range(100,110):
                out=root/controller/mapname/str(seed)
                if out.exists():p.error(f'Refusing to overwrite run: {out}')
                cmd=[str(binary),'--legacy-ai' if controller=='legacy' else '--cognition','--terrain',str(terrain),'--seed',str(seed),'--seconds','360','--evaluate','--no-trace','--out',str(out)]
                commands.append(cmd);(root/'commands.json').write_text(json.dumps(commands,indent=2)+'\\n')
                start=time.monotonic();r=subprocess.run(cmd,text=True,capture_output=True)
                result=dict(command=cmd,returncode=r.returncode,seconds=time.monotonic()-start,stdout=r.stdout,stderr=r.stderr)
                results.append(result);(root/'runs.json').write_text(json.dumps(results,indent=2)+'\\n')
                if r.returncode:raise RuntimeError(f'Battle failed: {cmd}: {r.stderr}')
                manifest=json.loads(next(out.glob('*/manifest.json')).read_text())
                zero+=manifest['shots']==0
                print(f'{controller} {mapname} {seed}: shots={manifest[\"shots\"]} zeros={zero}/3',flush=True)
                if zero>=3:
                    sets.append(dict(controller=controller,terrain=terrain,seeds_run=list(range(100,seed+1)),zero_shot_runs=zero,passed=False,aborted=True))
                    (root/'engagement-guard.json').write_text(json.dumps(dict(passed=False,aborted=True,reason='third zero-shot run in ten-seed set; all further measurement stopped',sets=sets),indent=2)+'\\n')
                    return 3
            sets.append(dict(controller=controller,terrain=terrain,seeds_run=list(range(100,110)),zero_shot_runs=zero,passed=zero==0,aborted=False))
            (root/'engagement-guard.json').write_text(json.dumps(dict(passed=all(s['passed'] for s in sets),aborted=False,sets=sets),indent=2)+'\\n')
    for terrain in ('works','trenches'):
        for tool,metric in [('measure_dispersion','dispersion'),('evaluate_tactics','tactics')]:
            subprocess.run([sys.executable,f'tools/{tool}.py',str(root/'legacy'/terrain),str(root/'cognition'/terrain),'--out',str(root/f'{metric}-{terrain}.json')],check=True)
    return 0 if all(s['passed'] for s in sets) else 3


if __name__=='__main__':raise SystemExit(main())
