    if(useful&&!p.action.established){p.action.established=p.action.everEstablished=true;Event(l,p,d,time,"drill_stage_advanced","support established: element delivered fire on threat area");}
    if(p.action.established&&time-p.action.lastEvidence>=8){p.action.established=false;p.action.lostAt=time;Event(l,p,d,time,"drill_stage_advanced","support lost: eight seconds without element delivery evidence");}
