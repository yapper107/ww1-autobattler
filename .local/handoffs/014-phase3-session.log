    for(const auto& s:members){int n=s.id%8;if(p.elements[n]==1&&p.action.rushOrders[n]){p.action.pausedOrders[n]=pause;p.issue[n]=true;}}
    Event(l,p,d,time,pause?"drill_safety_override":"drill_resume",pause?"support lost: retain instance, generation and protected rush endpoint":"fresh support evidence: resume retained rush contracts");
    Event(l,p,d,time,"drill_stage_advanced",pause?"support permission paused":"support permission resumed");
}
