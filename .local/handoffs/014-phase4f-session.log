        float judgment=.5f+.5f*std::clamp(bias,-1.f,1.f);
        region.estimate=region.low+(region.high-region.low)*judgment;
    }
    std::sort(result.begin(),result.end(),[](const auto& a,const auto& b){return a.x==b.x?a.y<b.y:a.x<b.x;});
    return result;
