sys.path.insert(0,'tools')
import closure_metrics,report_family
root=Path('.local/phase2b');cache=root/'diagnostics';cache.mkdir(exist_ok=True)
def enrich(item):
 key,row=item;path=cache/(key+'.json')
 if path.exists(): extra=json.loads(path.read_text())
 else:
  extra=closure_metrics.evaluate(row['run']);path.write_text(json.dumps(extra,indent=2)+'\\n')
 row=copy.deepcopy(row);row['closure_diagnostics']=str(path)
 for field in ('closure_120s_m','closure_240s_m','casualties_total'):row['metrics'][field]=extra[field]
 return row

