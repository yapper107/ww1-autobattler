   old.append(dict(controller=c,map=name,seed=s,gen_seed=0,run=str(Path(p['manifest']).parent),status='complete',initial_actives=t['outcome']['initial_actives'],survivors=t['outcome']['survivors'],metrics=dict(shots=i['shots'],casualty_azure=i['casualty_fractions'][0],casualty_ember=i['casualty_fractions'][1],nearest_m=r['nearest_squadmate_m']['median'],under_2m=r['nearest_squadmate_m']['share_below'])))
 groups=[old,authored,old_family['cases'],new_family['cases']];enriched=[]
 with ProcessPoolExecutor(max_workers=2) as pool:
  for group in groups:
