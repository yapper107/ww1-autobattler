 group=data['family_baselines']+data['family'] if name=='F1' else [r for r in data['authored_baselines']+data['authored'] if r['map']==name]
 for controller in ('legacy','candidate90','drills'):
  rows=[r['metrics'] for r in group if r['controller']==controller]
  mean=lambda k:statistics.mean(r[k] for r in rows if r[k] is not None)
