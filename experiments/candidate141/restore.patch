+namespace army {
+bool ReceivedFocusDelivery(const Soldier& officer,int support,Vec3 focus,float time){
+    for(const auto& delivery:officer.deliveries)if(delivery.shooter==support&&delivery.supportWeapon&&delivery.observedAt<=time&&
+        time-delivery.observedAt<=6&&Distance(delivery.target,focus)<=4){
+        int rounds=0;for(float at:delivery.times)rounds+=at>=time-6&&at<=time;if(rounds>=2)return true;
+    }
+    return false;
+}
+bool CanCoverFocus(const Map& map,Vec3 origin,Vec3 focus,float aimHeight){
+    if(Distance(origin,focus)>100)return false;
+    const Vec3 muzzle=origin+Vec3{0,0,1.5f};
+    if(ClearLine3D(map,muzzle,focus+Vec3{0,0,aimHeight})||ClearLine3D(map,muzzle,focus+Vec3{0,0,1.5f}))return true;
+    for(const auto& cover:CoverPositions(map))if(Distance(cover.peek,focus)<=4&&Distance(origin,cover.peek)<=100&&
+        ClearLine3D(map,muzzle,cover.peek+Vec3{0,0,1.5f}))return true;
+    return false;
+}
+bool RequestedThreatExposesStage(const AcceptedPlan& plan,const Soldier& officer,const std::vector<Soldier>& squad,const Map& map,float time){
+    if(!plan.route||plan.requestedThreat<0)return false;
+    const auto known=WithTracks(officer,time);const auto& contact=known.contacts[plan.requestedThreat];
+    if(!contact.known||contact.observedAt>time||time-contact.observedAt>=8)return false;
+    auto isolated=officer;isolated.contacts={};isolated.reports={};isolated.contacts[plan.requestedThreat]=contact;
+    TacticalRoutePlanner planner(map,isolated,time);
+    for(const auto& member:squad)if(member.Active()&&plan.movers[member.id%SquadSize]){
+        const auto path=FollowCorridor(map,*plan.route,member.position,plan.positions[member.id%SquadSize]);
+        if(path.empty()||planner.Measure(member.position,path).exposure>0)return true;
+    }
+    return false;
+}
+bool SupportFailureResolved(const FailedAttempt& failure,const Soldier& officer,int support,float time){
+    if(failure.cause!=TaskCause::Support||support<0)return false;
