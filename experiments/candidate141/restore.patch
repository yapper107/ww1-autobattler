+}
+bool BoundedSupportDeployment(const Soldier& officer,const Soldier& gun,const Map& map,const CoverPosition& slot,float time){
+    if(KnownPositionExposure(officer,map,slot.shelter,slot.crouch?Stance::Crouched:Stance::Standing,time))return false;
+    auto path=FindPath(map,gun.position,slot.shelter);if(path.empty())return false;
+    float length=0;Vec3 previous=gun.position;for(auto point:path){length+=Distance(previous,point);previous=point;}
+    if(length>40)return false;
+    auto known=officer;known.position=gun.position;known.machineGun=true;known.understoodHealth=gun.understoodHealth;
+    TacticalRoutePlanner planner(map,known,time);return planner.Measure(gun.position,path).fire<=.0001f;
+}
+bool MatchesSupportRefusal(const SupportRefusal& refusal,int shooter,uint64_t route,int stage,Vec3 sector,uint64_t geometry){
+    return refusal.observedAt>=0&&refusal.shooter==shooter&&refusal.route==route&&refusal.stage==stage&&refusal.geometry==geometry&&Distance(refusal.sector,sector)<6;
+}
